    runs.escalated_sample_count,
    runs.harness_error_count,
    runs.mean_latency_seconds,
    runs.median_latency_seconds,
    runs.total_cost_usd,
    runs.is_isolated
FROM runs
INNER JOIN fixtures
    ON
        runs.run_id = fixtures.run_id
        AND runs.contestant = fixtures.contestant
    ) as __dbt_sbq
    where false
    limit 0

