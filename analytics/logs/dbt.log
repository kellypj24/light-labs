  create view "lab"."intermediate"."int_eval_fixtures_scored__dbt_tmp" as (


SELECT
    run_id,
    stage,
    contestant,
    role,
    brain,
    fixture,
    category,
    run_id || '|' || contestant || '|' || fixture AS fixture_result_key,
    COUNT(*) AS sample_count,
    COUNT(*) FILTER (WHERE is_passed) AS passed_sample_count,
    BOOL_AND(is_passed) AS is_all_passed,
    BOOL_OR(is_harness_error) AS has_harness_error
FROM "lab"."staging"."stg_eval_samples"
GROUP BY run_id, stage, contestant, role, brain, fixture, category
  );

[0m17:30:35.257677 [debug] [Thread-4 (]: SQL status: OK in 0.001 seconds
[0m17:30:35.257906 [debug] [Thread-4 (]: Using duckdb connection "model.light_labs.int_eval_checks_unnested"
[0m17:30:35.258088 [debug] [Thread-4 (]: On model.light_labs.int_eval_checks_unnested: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "light_labs", "target_name": "duckdb", "node_id": "model.light_labs.int_eval_checks_unnested"} */


  create view "lab"."intermediate"."int_eval_checks_unnested__dbt_tmp" as (


WITH samples AS (

    SELECT
        sample_key,
        run_id,
        stage,
        contestant,
        role,
        fixture,
        category,
        FROM_JSON(
            checks, '[{"name": "VARCHAR", "passed": "BOOLEAN", "detail": "VARCHAR"}]'
        ) AS check_list
    FROM "lab"."staging"."stg_eval_samples"

),

unnested AS (

    SELECT
        sample_key,
        run_id,
        stage,
        contestant,
        role,
        fixture,
        category,
        UNNEST(check_list) AS check_result,
        GENERATE_SUBSCRIPTS(check_list, 1) AS check_index
    FROM samples

)

SELECT
    unnested.sample_key,
    unnested.run_id,
    unnested.stage,
    unnested.contestant,
    unnested.role,
    unnested.fixture,
    unnested.category,
    unnested.check_index,
    check_result.name AS check_name,
    unnested.sample_key || '|' || unnested.check_index AS check_key,
    COALESCE(check_result.passed, FALSE) AS is_passed,
    NULLIF(check_result.detail, '') AS check_detail
FROM unnested
  );

