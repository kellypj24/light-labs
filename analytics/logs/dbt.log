[0m17:29:48.124988 [debug] [Thread-4 (]: On model.light_labs.stg_eval_samples: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "light_labs", "target_name": "duckdb", "node_id": "model.light_labs.stg_eval_samples"} */


  create view "lab"."staging"."stg_eval_samples__dbt_tmp" as (


WITH source AS (

    SELECT *
    FROM "lab"."raw"."eval_samples"

),

renamed AS (

    SELECT
        run_id || '|' || contestant || '|' || fixture || '|' || sample AS sample_key,
        run_id,
        stage,
        contestant,
        role,
        brain,
        fixture,
        category,
        sample AS sample_number,
        passed AS is_passed,
        -- The scorer's first check is `ran`; it fails alone when the runner
        -- or the model call broke, which is not the model's fault.
        COALESCE(
            checks -> '$[0]' ->> 'name' = 'ran'
            AND NOT CAST(checks -> '$[0]' ->> 'passed' AS BOOLEAN),
            FALSE
        ) AS is_harness_error,
        NULLIF(escalate, '') AS escalation,
        NULLIF(escalate, '') IS NOT NULL AS is_escalated,
        draft,
        LENGTH(draft) AS draft_chars,
        latency_s AS latency_seconds,
        COALESCE(cost_usd, 0) AS cost_usd,
        isolated AS is_isolated,
        "commit" AS git_commit,
        dirty AS is_dirty,
        NULLIF("filter", '') AS fixture_filter,
        checks,
        NULLIF(error, '') AS error,
        "at" AS sampled_at,
        source AS source_file
    FROM source

)

SELECT * FROM renamed
  );

