# Copy to .env (git-ignored) and fill in.
# Agent Net edge base URL
LAB_EDGE=https://edge.example.ts.net:8443
# macOS Keychain service holding the Agent Net bearer token
LAB_KEYCHAIN_SERVICE=agentnet
# Ollama base URL
LAB_OLLAMA=http://localhost:11434
# Comma-separated board task ids where Rush answers every new comment (elsewhere it answers mentions)
RUSH_WATCH_TASKS=

# Rush on PJ's phone (docs/rush-phone.md). Texts go to this handle (PJ's own number);
# links point at the remote page published with `tailscale serve`.
RUSH_NOTIFY_TO=
RUSH_REMOTE_URL=
# Minutes until the Mac wakes for the next tick (needs the pmset sudoers line); 0 = off
RUSH_WAKE_MINUTES=0
