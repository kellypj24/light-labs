<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rush's phone page on 127.0.0.1:8787. Install with `just rush-install`; publish to the
     tailnet with `tailscale serve` (docs/rush-phone.md). No double hyphen in here: XML
     forbids it inside a comment, and tests/test_ops.py parses this file. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pjkelly.light-labs.rush-remote</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--no-sync</string>
    <string>--project</string>
    <string>/Users/pjkelly/.light-labs/lab/current</string>
    <string>lab</string>
    <string>rush</string>
    <string>remote</string>
  </array>
  <!-- launchd's PATH lacks /usr/local/bin, where the tailscale CLI lives. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>LAB_VAR</key><string>/Users/pjkelly/light-labs/var</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/pjkelly/light-labs/var/rush/remote.log</string>
  <key>StandardErrorPath</key><string>/Users/pjkelly/light-labs/var/rush/remote.log</string>
</dict>
</plist>
