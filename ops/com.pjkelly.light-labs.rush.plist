<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly heartbeat for DLN-100 Rush. Install with `just rush-install`.
     caffeinate keeps the Mac awake until the tick is done; with RUSH_WAKE_MINUTES set,
     each tick schedules the wake for the next one (docs/rush-phone.md). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pjkelly.light-labs.rush</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>/Users/pjkelly/light-labs</string>
    <string>lab</string>
    <string>rush</string>
    <string>tick</string>
  </array>
  <!-- Top of every hour, the same slot the tick schedules its wake for (phone.py).
       A StartInterval timer counts from the last run and drifts off the wakes. -->
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>0</integer></dict>
  <!-- Tick on load too: without it, every bootstrap (e.g. after pausing Rush for an
       eval) restarts the hour before the first tick. -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/pjkelly/light-labs/var/rush/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/pjkelly/light-labs/var/rush/launchd.log</string>
</dict>
</plist>
